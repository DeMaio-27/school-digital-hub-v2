# School Digital Hub v2 - Apache/XAMPP compatible configuration

# Disable directory listing
Options -Indexes

# Protect common sensitive files without using DirectoryMatch
<FilesMatch "^(\.env|\.htaccess|\.htpasswd|composer\.(json|lock)|.*\.(ini|log|sh))$">
    Require all denied
</FilesMatch>

# Compress text responses when the module is available
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json
</IfModule>

# Basic security headers when the module is available
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
