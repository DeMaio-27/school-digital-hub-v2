# School Digital Hub v2 - Apache Configuration

# Abilita rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /school-digital-hub-v2/
    
    # Redirect HTTPS (opzionale, per produzione)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Proteggi file sensibili
<FilesMatch "^\.(htaccess|htpasswd|ini|log|sh|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Proteggi cartelle di configurazione
<IfModule mod_authz_core.c>
    <DirectoryMatch "/(config|includes|database)/">
        Require all denied
    </DirectoryMatch>
</IfModule>

# Abilita GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# Cache control per asset statici
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Directory listing disabilitato
Options -Indexes

# Error pages personalizzate (opzionale)
# ErrorDocument 404 /school-digital-hub-v2/404.html
# ErrorDocument 403 /school-digital-hub-v2/403.html
# ErrorDocument 500 /school-digital-hub-v2/500.html
